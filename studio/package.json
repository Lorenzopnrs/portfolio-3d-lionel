{
  "name": "portfolio-lionel",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "lint": "eslint .",
    "migrate:content": "sanity exec scripts/migrateContent.mjs --with-user-token",
    "start": "sanity start",
    "typecheck": "tsc --noEmit",
    "verify:content": "sanity exec scripts/verifyContent.mjs --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.9.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.9.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
